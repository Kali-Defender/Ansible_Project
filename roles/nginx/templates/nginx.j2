server {
    listen 80;
    server_name _;

    root /var/www/html;
    index index.nginx-debian.html index.html; {# 在 Debian/Ubuntu 系统上，Nginx 安装后的默认欢迎页文件名为 index.nginx-debian.html，而不是 index.html。 #}
    location / {
        try_files $uri $uri/ =404;
    }

    location = /hello {
        add_header Content-Type text/plain;
        return 200 'hello from {{ inventory_hostname }} ({{ ansible_default_ipv4.address }})\n';
    }
}